# Copy to .env for local development. .env is gitignored.

# --- gateway-service ---
AUTH_ENABLED=true
API_KEYS=dev-key-local
ORCHESTRATOR_URL=http://localhost:8082
SIGNALING_URL=ws://localhost:8081

# --- session-orchestrator ---
REGISTRY_URL=http://localhost:8083
SIGNALING_BASE_URL=ws://localhost:8081

# --- registry-service ---
# Leave SPRING_PROFILES_ACTIVE empty for in-memory mode; set to "redis" for the
# distributed Redis-backed store.
SPRING_PROFILES_ACTIVE=
REDIS_HOST=localhost
REDIS_PORT=6379

# --- signaling-service ---
SIGNALING_ALLOWED_ORIGINS=*
